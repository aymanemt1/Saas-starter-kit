# Copy this file to .env and fill in your keys.
# Without keys the app runs in DEMO mode (mock auth + localStorage data).

# Clerk — https://dashboard.clerk.com (Publishable key)
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase — https://supabase.com/dashboard (Project URL + anon public key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
